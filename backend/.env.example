# Application
APP_NAME=StockLedger
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Database (async URL for app, sync for Alembic)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/inventory_db
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/inventory_db

# JWT
SECRET_KEY=change-me-to-a-long-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT=100/minute

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Admin seed (optional)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
